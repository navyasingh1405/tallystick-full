  <h2><span class="num">10</span>{{ sections[9].title }}</h2>
  <p class="purpose">{{ sections[9].purpose }}</p>
  <p class="rationale">
    Reproduced verbatim from the repository's limitations document, so that what
    appears here is what the project maintains rather than a summary written for this
    document.
  </p>
