<section>
  <h2><span class="num">11</span>{{ sections[10].title }}</h2>
  <p class="purpose">{{ sections[10].purpose }}</p>
  {% for block in monitoring %}
  <h3>{{ block.heading }}</h3>
  {% for para in block.paragraphs %}
  {% if para.startswith("-") %}
