{# ----------------------------------------------------------- 12 regulatory #}
<section>
  <h2><span class="num">12</span>{{ sections[11].title }}</h2>
  <p class="purpose">{{ sections[11].purpose }}</p>

  <p>
    These are pointers to the frameworks this document is structured against, not
    quotations of them, and not a claim of compliance with any of them. Current text
    should be verified before this mapping is relied upon.
  </p>

  {% for key, f in frameworks.items() %}
  <h4>{{ f.label }}</h4>
  <p class="rationale">{{ f.note }}</p>
  {% endfor %}

  <h3>Section mapping</h3>
  <table>
    <thead>
      <tr><th class="num">&sect;</th><th>Section</th><th>SR 11-7</th><th>EU AI Act</th><th>ECOA / Reg B</th></tr>
    </thead>
    <tbody>
      {% for row in regulatory %}
      <tr>
        <td class="num">{{ row.number }}</td>
        <td>{{ row.title }}</td>
        <td class="rationale">{{ row.sr117 | join("; ") or "&mdash;" }}</td>
        <td class="rationale">{{ row.eu_ai_act | join("; ") or "&mdash;" }}</td>
        <td class="rationale">{{ row.ecoa | join("; ") or "&mdash;" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="footnote">
    Generated by Tallystick on {{ generated_at }} from model {{ model.version }}
    (SHA-256 {{ model.hash_short }}&hellip;). Every figure in this document was read
    from a generated artifact; none was entered by hand. Regenerating after retraining
    produces a document describing the new model with no manual editing.
  </div>
</section>

</body>
